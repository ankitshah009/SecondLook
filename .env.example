# Local development can run browser inspection without provider credentials.
# Never commit .env.local.
APP_URL=http://localhost:3000
BROWSER_PROVIDER=local
# macOS uses installed Chrome. Other systems can point to Chromium:
# PLAYWRIGHT_EXECUTABLE_PATH=/absolute/path/to/chromium

# For the credentialed hackathon stack, set BROWSER_PROVIDER=kernel and
# APP_URL to a publicly reachable deployment URL.
KERNEL_API_KEY=
DATABASE_URL=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_MODEL=gpt-5-mini
SECOND_LOOK_SIGNING_SECRET=
EXA_API_KEY=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Production must use Neon, not process-local storage.
REQUIRE_NEON=false
